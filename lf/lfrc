# Basic Settings
set ignorecase true # ignore capital vs lowercase
set info size:time # default info to be more descriptive
set infotimefmtnew '2006/01/02 15:04:05'
set infotimefmtold '2006/01/02 15:04:05'
set relativenumber # relative line number for cursor
set ratios 2:3:4 # ratio of column widths
set period 1 # freq in seconds for directory update

# copy file contents into clipboard
cmd yankfile ${{
	pbcopy < "$f"
}}

# copy file path into clipboard
cmd yankpath ${{
	printf '%s' "$f" | pbcopy
}}

# make a new directory
cmd mkdir ${{
	printf "Directory Name: "
	read ans
	mkdir "$ans"
}}

# make a new file
cmd mkfile ${{
	printf "File Name: "
	read ans
	$EDITOR $ans
}}

# put something in the trash bin
cmd trash ${{
	trash "$f"
}}

cmd rmrf ${{
	rm -rf "$f"
}}

# unarchive
cmd unarchive ${{
	case "$f" in
		*.zip) unzip "$f" ;;
		*.tar.gz tar -xzvf "$f" ;;
		*.tar.bz2) tar -xjvf "$f" ;;
		*.tar) tar -xcf "$f" ;;
		*) echo "Unsupported format" ;;
	esac
}}

# Bindings

# Removing defaults
map m
map o
map "'"
map '"'
map d

# Custom keybindings
map C  $codium "$f"
map au unarchive
map v  $iina "$f"
map o  $zathura "$f"
map dD rmrf
map Yp  yankpath 
map Yf yankfile

# Basic Functions
map . set hidden!
map p paste
map x cut
map y copy
map <enter> open
map R reload
map mf mkfile
map md mkdir
map dd trash

